{
  "name": "ogis-tiles",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "dev": "concurrently -k -n server,harness -c blue,green \"npm:dev:server\" \"npm:dev:harness\"",
    "dev:server": "node --env-file-if-exists=.env --watch src/server.mjs",
    "dev:harness": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "@playwright/test": "^1.64.1",
    "concurrently": "^10.0.6",
    "maplibre-gl": "^6.16.0",
    "pbf": "^5.1.2",
    "pmtiles": "^4.5.0",
    "prettier": "^3.9.10",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
