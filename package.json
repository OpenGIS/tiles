    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "pbf": "^5.1.2",
    "pmtiles": "^4.5.0",
    "prettier": "^3.9.10",
    "vitest": "^5.0.5"
  }
}
