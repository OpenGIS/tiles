# Template environment file. Copy to `.env` and fill in the values.
# `.env` is ignored by git; never commit real credentials.

# Hetzner Cloud API token, scoped to the tile server project.
HCLOUD_TOKEN=

# Public hostname. A DNS A record is required.
TILE_SERVER_HOST=tiles.example.com

# SSH key used for provisioning and deployment.
SSH_PRIVATE_KEY_PATH=~/.ssh/ogis_tiles

# SSH key the build box uses to write archives to the tile server.
BUILD_SSH_PRIVATE_KEY_PATH=~/.ssh/ogis_tiles_build

# Name of the tile server.
SERVER_NAME=ogis-tiles

# Hetzner Cloud server type.
SERVER_TYPE=cx23

# Hetzner Cloud location.
LOCATION=nbg1

# Base image for the tile server.
IMAGE=ubuntu-26.04

# Optional planet build overrides.
PLANET_DATE=
PLANET_URL=
PLANET_SHA256=

# Set to 1 to keep the build box after a build.
KEEP_BUILD_BOX=0

# Production port behind nginx. Use a free port in the 11001–11999 range locally.
PORT=11010

# Public origin used in TileJSON URLs. Leave empty to derive it from each request.
PUBLIC_BASE_URL=
