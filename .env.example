# Template environment file. Copy to `.env` and fill in the values.
# `.env` is ignored by git; never commit real credentials.

# Hetzner Cloud API token, scoped to the tile server project.
HCLOUD_TOKEN=

# Public hostname. A DNS A record is required.
TILE_SERVER_HOST=tile.ogis.app

# Public IPv4 address of the tile server. Rebuilds retain this address.
TILE_SERVER_IP=128.140.70.114

# SSH key used for provisioning and deployment.
SSH_PRIVATE_KEY_PATH=~/.ssh/ogis_tiles

# Optional public key overrides. By default `<private path>.pub` is read when it
# exists; otherwise the public key is derived with `ssh-keygen -y -f`.
SSH_PUBLIC_KEY_PATH=
BUILD_SSH_PUBLIC_KEY_PATH=

# SSH key the build box uses to write archives to the tile server.
BUILD_SSH_PRIVATE_KEY_PATH=~/.ssh/ogis_tiles_build

# Let's Encrypt account email used when TLS is installed after a rebuild.
CERTBOT_EMAIL=

# Linux users created by cloud-init.
DEPLOY_USER=deploy
BUILD_USER=build

# Node.js is pinned by src/provision/cloud-init.mjs (currently v24.22.2).

# Name of the tile server.
SERVER_NAME=ogis-tiles

# Hetzner Cloud server type.
SERVER_TYPE=cx23

# Hetzner Cloud location.
LOCATION=nbg1

# Base image for the tile server.
IMAGE=ubuntu-26.04

# Optional planet build overrides. Ambient planet pins do not affect fixture
# checksums: fixture builds use the adjacent fixture manifest checksum, and an
# explicit --planet-sha256 can override it. MD5 applies only to planet inputs.
# SHA-256 is preferred; both are checked when both are set.
PLANET_DATE=
PLANET_URL=
PLANET_SHA256=
PLANET_MD5=

# Planet build heap override. Empty falls back to each source's heapPlanet.
PLANET_BUILD_HEAP=

# Remote build box. Override per run with --build-server-type, --build-location
# and --build-image.
# CPX62 provides a 640 GB disk and supports filtered planet builds. An unfiltered
# (--skip-filter) build needs about 850 GiB and is rejected unless the server type
# provides more disk.
BUILD_SERVER_TYPE=cpx62
BUILD_SERVER_LOCATION=nbg1
BUILD_SERVER_IMAGE=ubuntu-26.04

# Remote build paths. The restricted build key is provisioned with rrsync against
# /opt/ogis-tiles/data/incoming, so a remote build rejects TILE_DATA_DIR or
# TILE_INCOMING_DIR that point elsewhere. TILE_APP_DIR must be a child of /opt or
# /srv on the build box.
TILE_APP_DIR=/opt/ogis-tiles
TILE_DATA_DIR=/opt/ogis-tiles/data
TILE_INCOMING_DIR=/opt/ogis-tiles/data/incoming

# Minimum free bytes on the tile server data filesystem before a build box starts
# (default 8 GiB).
BUILD_DESTINATION_MIN_FREE_BYTES=8589934592

# Remote build and per-source transfer timeouts in milliseconds (default 24 hours
# and 4 hours). A failure during the build keeps the box; remove it with
# `hcloud server delete <id>`.
BUILD_BOX_TIMEOUT_MS=86400000
BUILD_BOX_TRANSFER_TIMEOUT_MS=14400000

# Set to 1 to keep the build box after a build. --keep-build-box and
# --no-destroy do the same per run; --no-transfer always keeps the box.
KEEP_BUILD_BOX=0

# Production port behind nginx. Use a free port in the 11001–11999 range locally.
PORT=11010

# Public origin used in TileJSON URLs. Leave empty to derive it from each request.
PUBLIC_BASE_URL=
