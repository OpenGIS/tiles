{
  "version": 1,
  "server": { "host": "127.0.0.1", "port": 11010 },
  "build": {
    "planet": {
      "date": "",
      "url": "https://planet.openstreetmap.org/pbf/planet-latest.osm.pbf",
      "sha256": ""
    },
    "tools": {
      "planetiler": {
        "version": "0.10.2",
        "url": "https://github.com/onthegomap/planetiler/releases/download/v0.10.2/planetiler.jar",
        "sha256": "f310bd0413e2e4512b27f4046d418664e8e1d3bf31603c2a70e23de06c167e4d"
      },
      "pmtiles": "1.31.2"
    },
    "outputDir": "dist"
  },
  "sources": {
    "pois": {
      "kind": "pmtiles",
      "title": "Outdoor POIs",
      "description": "Huts, shelters, viewpoints and other outdoor points of interest.",
      "attribution": [
        { "title": "OpenStreetMap", "href": "https://www.openstreetmap.org/copyright" }
      ],
      "archiveDir": "data/pois",
      "minzoom": 12,
      "maxzoom": 16,
      "build": {
        "profile": "pois",
        "minzoom": 0,
        "maxzoom": 16,
        "expressions": [
          "nwr/tourism=alpine_hut,wilderness_hut",
          "nwr/amenity=shelter",
          "nwr/tourism=viewpoint",
          "nwr/tourism=camp_site,camp_pitch",
          "nwr/tourism=picnic_site",
          "nwr/amenity=drinking_water",
          "nwr/highway=trailhead",
          "nwr/natural=saddle",
          "nwr/amenity=ranger_station",
          "nwr/historic=castle",
          "nwr/tourism=information",
          "nwr/amenity=parking",
          "nwr/leisure=park",
          "nwr/amenity=toilets",
          "nwr/leisure=playground",
          "nwr/amenity=ferry_terminal",
          "nwr/man_made=lighthouse",
          "nwr/leisure=ski_resort"
        ],
        "sampleTiles": [
          { "z": 13, "x": 1471, "y": 2739 },
          { "z": 13, "x": 1466, "y": 2735 }
        ],
        "verification": {
          "layer": "outdoor_pois",
          "requiredAttributes": ["kind", "name"]
        },
        "sizeFloor": {
          "fixture": 4096,
          "planet": 104857600
        }
      }
    },
    "routes": {
      "kind": "pmtiles",
      "title": "Outdoor routes",
      "description": "Hiking and cycling route relations.",
      "attribution": [
        { "title": "OpenStreetMap", "href": "https://www.openstreetmap.org/copyright" }
      ],
      "archiveDir": "data/routes",
      "minzoom": 8,
      "maxzoom": 14,
      "build": {
        "profile": "routes",
        "profileKind": "java",
        "profileFile": "build/profiles/routes.java",
        "heap": "2g",
        "heapPlanet": "8g",
        "minzoom": 8,
        "maxzoom": 14,
        "expressions": [
          "r/route=*hiking*",
          "r/route=*bicycle*",
          "r/route=*foot*",
          "r/route=*walking*"
        ],
        "sampleTiles": [
          { "z": 13, "x": 1465, "y": 2735 },
          { "z": 12, "x": 733, "y": 1367 }
        ],
        "verification": {
          "layer": "outdoor_routes",
          "geometry": "line",
          "requiredAttributes": ["activity", "activities"]
        },
        "sizeFloor": {
          "fixture": 65536,
          "planet": 104857600
        }
      }
    },
    "paths": {
      "kind": "pmtiles",
      "title": "Outdoor paths",
      "description": "Hiking paths and footways.",
      "attribution": [
        { "title": "OpenStreetMap", "href": "https://www.openstreetmap.org/copyright" }
      ],
      "archiveDir": "data/paths",
      "minzoom": 9,
      "maxzoom": 13,
      "build": {
        "profile": "paths",
        "profileKind": "java",
        "profileFile": "build/profiles/paths.java",
        "heap": "2g",
        "heapPlanet": "8g",
        "minzoom": 9,
        "maxzoom": 13,
        "expressions": [
          "r/route=*hiking*",
          "r/route=*bicycle*",
          "r/route=*foot*",
          "r/route=*walking*",
          "w/highway=path",
          "w/highway=footway",
          "w/highway=track"
        ],
        "sampleTiles": [
          { "z": 13, "x": 1465, "y": 2735 },
          { "z": 13, "x": 1469, "y": 2739 }
        ],
        "verification": {
          "layer": "outdoor_paths",
          "geometry": "line",
          "requiredAttributes": ["class", "network"]
        },
        "sizeFloor": {
          "fixture": 131072,
          "planet": 104857600
        }
      }
    },
    "contours": {
      "kind": "contour",
      "title": "Terrain contours",
      "description": "Contour lines generated on demand from a worldwide elevation model.",
      "attribution": [{ "title": "Mapterhorn", "href": "https://mapterhorn.com/attribution" }],
      "minzoom": 1,
      "maxzoom": 15,
      "demUrl": "https://tiles.mapterhorn.com/{z}/{x}/{y}.webp",
      "encoding": "terrarium",
      "demMaxzoom": 12,
      "demTileSize": 512,
      "cacheSize": 100,
      "timeoutMs": 10000,
      "buffer": 1,
      "extent": 4096,
      "contourLayer": "contours",
      "elevationKey": "ele",
      "levelKey": "level",
      "cacheMaxAge": 86400,
      "thresholds": {
        "1": [600, 3000],
        "4": [300, 1500],
        "8": [150, 750],
        "9": [80, 400],
        "10": [20, 100],
        "11": [20, 100],
        "12": [20, 100],
        "13": [10, 50],
        "14": [5, 25]
      }
    }
  }
}
